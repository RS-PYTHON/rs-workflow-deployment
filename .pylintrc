[MAIN]
# Symbolic links to scripts/deploy_flows.py, already analysed
ignore-paths=apps/.*/deploy_flows.py

[FORMAT]
max-line-length=120

[MESSAGES CONTROL]
# The flows are deployed in the rs-client-libraries image, whose packages are not installed for the code quality check
disable=import-error
